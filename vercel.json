{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/", "destination": "/index.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/jobs/refresh", "destination": "/api/jobs-refresh" },
    { "source": "/api/profile/cv", "destination": "/api/profile-cv" }
  ]
}
